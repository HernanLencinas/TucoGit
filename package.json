{
  "name": "tucogit",
  "version": "1.0.0",
  "description": "TucoGit",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "electron-builder",
    "build": "npm run build:renderer && npm run build:electron",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "build:windows": "npm run build:renderer && electron-builder --win",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:all": "npm run build:renderer && electron-builder --linux --win --mac",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "preview": "vite preview"
  },
  "keywords": [
    "electron",
    "desktop"
  ],
  "author": {
    "name": "Hernan Lencinas",
    "email": "lencinas.hernan@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-toast": "^1.1.5",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "i18next": "^23.16.8",
    "lucide-react": "^0.309.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.5.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.tucogit.app",
    "productName": "TucoGit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-renderer/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "build/**/*",
      "package.json",
      "!dist/**/*",
      "!src/renderer/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/chokidar/**/*",
      "**/node_modules/readdirp/**/*",
      "**/node_modules/fsevents/**/*",
      "**/node_modules/anymatch/**/*",
      "**/node_modules/braces/**/*",
      "**/node_modules/glob-parent/**/*",
      "**/node_modules/is-binary-path/**/*",
      "**/node_modules/is-glob/**/*",
      "**/node_modules/normalize-path/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "maintainer": "lencinas.hernan@gmail.com",
      "icon": "icons/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "icons/icon.icns",
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
